// D 段：实地点位验证。
//
// 公式算例只能证明"实现遵循公式"，不能证明"在真实位置上的精度"——这正是初审
// 驳回意见第 4 条的要点。这里换成德国 BKG（联邦制图与大地测量局）发布的 31 个
// 官方测试点（BETA2007testdaten.csv），真实经纬度，覆盖 47.6°N–54.7°N 的德国全境。
//
// 网格路径（EPSG:15948）需要 BETA2007.gsb，文件不入库，所以本文件只对 7 参数
// 路径做断言：那条路径不依赖任何外部数据，是 CI 里必须守住的那一条。网格路径的
// 逐点数字在 verification/results/ 里由脚本生成，见 docs/VERIFICATION.md。

///|
/// BKG 官方点位：DHDN 经纬度 → ETRS89 经纬度。
/// 原始数据与出处见 verification/data/dhdn_bkg_points.csv。
fn bkg_points() -> Array[(Double, Double, Double, Double)] {
  [
    (7.483333333333, 53.5, 7.482506019176, 53.498461143331),
    (10.333333333333, 48.833333333333, 10.332117283303, 48.83232718864),
    (8.0, 50.083333333333, 7.999097344043, 50.082172046476),
    (10.016666666667, 51.033333333333, 10.015460839103, 51.032075951188),
    (10.466666666667, 54.333333333333, 10.465373788153, 54.331696254077),
    (10.75, 53.583333333333, 10.748659705929, 53.581781243436),
    (10.016666666667, 53.5, 10.015444367463, 53.49845750362),
    (11.0, 53.466666666667, 10.998619309575, 53.465127257963),
    (13.466666666667, 53.766666666667, 13.464877774631, 53.765109112396),
    (10.983333333333, 52.766666666667, 10.981965431979, 52.765211787713),
    (13.0, 51.783333333333, 12.998336654827, 51.782006921265),
    (10.466666666667, 52.5, 10.465380298337, 52.498573633365),
    (10.55, 51.466666666667, 10.54871146738, 51.465361979987),
    (10.45, 50.583333333333, 10.448735275612, 50.582129474187),
    (10.416666666667, 49.666666666667, 10.415423634267, 49.665566047661),
    (10.55, 47.75, 10.548775945187, 47.749120260296),
    (13.45, 50.666666666667, 13.448283429558, 50.665476385913),
    (13.55, 51.333333333333, 13.548264242652, 51.332063317958),
    (13.566666666667, 52.05, 13.564906713066, 52.048646469731),
    (13.433333333333, 53.166666666667, 13.431569610583, 53.165185284138),
    (13.466666666667, 52.483333333333, 13.464913254978, 52.481930297429),
    (13.133333333333, 49.066666666667, 13.13170694705, 49.065661709281),
    (8.666666666667, 53.116666666667, 8.665654272188, 53.115169791635),
    (12.95, 47.65, 12.948437185277, 47.649155713893),
    (8.5, 54.716666666667, 8.499027339833, 54.714992333813),
    (7.483333333333, 51.983333333333, 7.482494584516, 51.981965147975),
    (7.516666666667, 51.016666666667, 7.515823996992, 51.015402184493),
    (7.466666666667, 50.5, 7.465834308888, 50.498791390585),
    (7.533333333333, 49.333333333333, 7.532503616986, 49.332250779407),
    (7.25, 49.333333333333, 7.249209260581, 49.332249456364),
    (7.533333333333, 47.666666666667, 7.532530252396, 47.665765608135),
  ]
}

///|
test "BKG 31 个官方点上，7 参数路径全部落在标称精度内" {
  let src = @crs.parse("+proj=longlat +ellps=bessel +datum=potsdam") catch {
    _ => {
      assert_true(false)
      return
    }
  }
  let dst = @epsg.get(4258)
  let pts = bkg_points()
  let mut worst = 0.0
  let pool : Array[Double] = []
  for p in pts {
    // 失败时退化成 (0, 0)，后面算出的距离会是几千公里，断言自然失败。
    // 不用 continue：这组测试的前提是"每个点都必须能转"。
    let out = @crs.transform(src, dst, p.0, p.1) catch {
      _ => (0.0, 0.0)
    }
    let d = dist_m(out.0, out.1, p.2, p.3)
    pool.push(d)
    if d > worst {
      worst = d
    }
  }
  // 标称 3 m，实测最大 2.55 m（docs/VERIFICATION.md）。这里卡 3.2 m 而不是
  // 放宽到 6 m：参数一旦被换掉，残差会成倍跳，3.2 m 立刻能发现。
  assert_true(worst < 3.2)
  // 中位数远小于标称，说明 3 m 是保守上界而不是平均值——这一点写进文档，
  // 免得有人把"标称 3 m"读成"平均 3 m"。
  pool.sort()
  let median = pool[pool.length() / 2]
  assert_true(median < 1.2)
}

///|
test "DHDN→ETRS89 在注册表里同时登记了网格与 7 参数两条运算" {
  // 同一对基准有多条精度不同的运算，是本次结构性修订的核心主张。
  // 只有一条就说明又退回"一套参数走天下"的老路。
  let matched : Array[@operation.CoordinateOperation] = []
  for op in @operation.all() {
    if op.source == "DHDN" && op.target == "ETRS89" {
      matched.push(op)
    }
  }
  assert_eq(matched.length(), 2)
  let mut grid_acc = 0.0
  let mut seven_acc = 0.0
  let mut has_grid = false
  let mut has_seven = false
  for op in matched {
    match op.accuracy_m {
      Some(a) =>
        if op.needs_grid() {
          has_grid = true
          grid_acc = a
        } else {
          has_seven = true
          seven_acc = a
        }
      None => assert_true(false)
    }
  }
  assert_true(has_grid && has_seven)
  assert_true(grid_acc <= 0.2)
  assert_true(seven_acc >= 2.0)
  // 精度差至少一个数量级，"有两条"才有意义
  assert_true(seven_acc / grid_acc >= 10.0)
}

///|
test "EPSG:15948 绑定的网格标识是 BETA2007，换掉就会找不到文件" {
  let op = @operation.by_code("EPSG:15948") catch {
    _ => {
      assert_true(false)
      return
    }
  }
  assert_true(op is Some(_))
  let o = match op {
    Some(o) => o
    None => return
  }
  assert_true(o.needs_grid())
  assert_true(o.note.contains("BETA2007"))
}
